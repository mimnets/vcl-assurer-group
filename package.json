{
  "name": "vcl-assurer-group",
  "version": "0.0.1",
  "private": true,
  "description": "VCL-ASSURER-GROUP — Assurer World corporate website on ApostropheCMS Community Edition (Milestone 0 proof of concept)",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "start": "node app",
    "dev": "nodemon",
    "build": "cross-env NODE_ENV=production node app @apostrophecms/asset:build",
    "serve": "cross-env NODE_ENV=production node app",
    "release": "npm install && npm run build && node app @apostrophecms/migration:migrate",
    "seed:demo": "node app assurer-demo:seed",
    "test:smoke": "node scripts/smoke-test.mjs",
    "lint": "eslint .",
    "test:workflow": "node --env-file=.env scripts/editor-workflow-test.mjs",
    "test:persistence": "node --env-file=.env scripts/editor-workflow-test.mjs --verify-only"
  },
  "nodemonConfig": {
    "delay": 1000,
    "verbose": true,
    "watch": [
      "./app.js",
      "./modules/**/*",
      "./lib/**/*.js",
      "./views/**/*.html",
      "./views/**/*.jsx"
    ],
    "ignoreRoot": [
      ".git"
    ],
    "ignore": [
      "**/ui/",
      "locales/*.json",
      "public/uploads/",
      "public/apos-frontend/*.js",
      "data/"
    ],
    "ext": "json, js, cjs, jsx, html"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "author": "Assurer World",
  "license": "UNLICENSED",
  "dependencies": {
    "@apostrophecms/form": "^1.5.6",
    "@apostrophecms/vite": "^1.2.0",
    "apostrophe": "^4.34.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "normalize.css": "^8.0.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "eslint-config-apostrophe": "^6.0.1",
    "nodemon": "^3.0.1"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "better-sqlite3": true,
    "esbuild": true,
    "fsevents": true,
    "sharp": true,
    "unrs-resolver": true,
    "vue-demi": true
  }
}
