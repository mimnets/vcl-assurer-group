# VCL-ASSURER-GROUP — environment variables (EXAMPLE ONLY)
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# Never commit real secrets.

# --- Database -----------------------------------------------------------
# Local proof-of-concept uses SQLite (no database server required).
# The path after `sqlite://` is a filesystem path, relative to the project
# root. The `data/` directory is git-ignored.
APOS_DB_URI=sqlite://./data/vcl-assurer-group.db
#
# Alternatives supported by @apostrophecms/db-connect (Community Edition):
# APOS_DB_URI=mongodb://localhost:27017/vcl-assurer-group
# APOS_DB_URI=postgres://<user>:<password>@localhost:5432/vcl_assurer_group

# --- Sessions -----------------------------------------------------------
# REQUIRED. A long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The app refuses to start without it.
APOS_SESSION_SECRET=

# --- Server -------------------------------------------------------------
# PORT=3000
# Bind address. Defaults to 127.0.0.1 (this machine only).
# ADDRESS=127.0.0.1

# Set to 1 to force the admin UI to rebuild on every nodemon restart.
# Only needed when actively developing Apostrophe admin UI code.
# APOS_DEV=1

# --- HTTPS, reverse proxy and abuse limits (m1-011) -------------------
# All off by default; plain-HTTP local development needs none of them.
# Invalid or unsafe combinations stop the app at startup. Details:
# docs/runbooks/security-configuration.md
#
# Served to browsers over HTTPS through a TLS-terminating proxy: Secure
# session and CSRF cookies. Requires APOS_TRUST_PROXY.
# APOS_HTTPS=1
# Proxies allowed to set X-Forwarded-For/-Proto: a hop count (1-10),
# loopback / linklocal / uniquelocal, or IP addresses and CIDR ranges.
# "true" and "*" are refused.
# APOS_TRUST_PROXY=loopback
# Strict-Transport-Security max-age in seconds. Requires APOS_HTTPS=1.
# APOS_HSTS_MAX_AGE=31536000
# Contact-form submissions per client IP per window (defaults 10 / 15 min).
# APOS_FORM_RATE_LIMIT_MAX=10
# APOS_FORM_RATE_LIMIT_WINDOW_MINUTES=15

# --- Contact-form notifications and retention (m1-012) ----------------
# All off by default: without APOS_SMTP_HOST no email is sent and
# submissions are only stored. Invalid combinations stop the app at
# startup. Details: docs/runbooks/form-operations-and-privacy.md
#
# APOS_SMTP_HOST=smtp.example.com
# APOS_SMTP_PORT=587
# 1 = implicit TLS (port 465). Otherwise STARTTLS is required; set
# APOS_SMTP_REQUIRE_TLS=0 only for a local test sink on 127.0.0.1.
# APOS_SMTP_SECURE=0
# APOS_SMTP_REQUIRE_TLS=1
# Secret: secret store or .env only.
# APOS_SMTP_USER=
# APOS_SMTP_PASSWORD=
# Plain addresses only. Recipients are fixed here (up to 5, comma-separated).
# APOS_EMAIL_FROM=website@example.com
# APOS_FORM_NOTIFY_TO=forms@example.com
# 1 = include submitted values in the email (needs owner/DPO approval).
# APOS_FORM_NOTIFY_INCLUDE_VALUES=0
# Public site address, used for the link in notification emails.
# APOS_BASE_URL=https://www.example.com
# Owner-approved retention in days (30-3650). Needed before
# `node app assurer-forms:retention --execute` may delete anything.
# APOS_FORM_RETENTION_DAYS=

# --- Production builds -------------------------------------------------
# Required when NODE_ENV=production (npm run build / npm run serve) unless
# the deployment is a git checkout. Any short unique string per release.
# APOS_RELEASE_ID=

# --- Local test credentials (npm run test:workflow / test:persistence) ---
# A local admin created with `node app @apostrophecms/user:add <user> admin`.
# APOS_TEST_USER=
# APOS_TEST_PASSWORD=
